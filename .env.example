# Modèle de `.env` — copier ce fichier : `cp .env.example .env`
#
# `.env` est volontairement gitignoré (chaque poste garde ses valeurs locales) ; CE modèle
# est versionné, lui, pour que le projet soit reproductible ailleurs. Aucune valeur ici
# n'est un secret : ce sont des variables de config Airflow (`AIRFLOW__<SECTION>__<CLE>`).
#
# Usage : lu par `astro dev start` uniquement. Pour un déploiement hors Astro CLI, ces
# variables doivent être reprises dans l'environnement du déploiement (values Helm, config
# map, secrets manager) — `.env` est aussi au `.dockerignore`, il n'entre donc JAMAIS
# dans une image.
#
# ⚠️ Le thème JSON multiligne ci-dessous casse `astro dev pytest` (refusé par
# `docker run --env-file`) → lancer les tests via `docker run` sur l'image du projet,
# voir README §5.

# Nom affiché dans l'UI Airflow (coin supérieur gauche).
AIRFLOW__WEBSERVER__INSTANCE_NAME="Airflow D2B - env prd"

# Thème de l'UI Airflow 3 (palette `brand` en oklch). JSON multiligne accepté par
# `astro dev start`, collé tel quel.
AIRFLOW__API__THEME='{
  "tokens": {
    "colors": {
      "brand": {
        "50": { "value": "oklch(0.970 0.020 46.5)" },
        "100": { "value": "oklch(0.940 0.040 46.5)" },
        "200": { "value": "oklch(0.890 0.080 46.5)" },
        "300": { "value": "oklch(0.830 0.130 46.5)" },
        "400": { "value": "oklch(0.760 0.170 46.5)" },
        "500": { "value": "oklch(0.688 0.209 46.5)" },
        "600": { "value": "oklch(0.620 0.190 46.5)" },
        "700": { "value": "oklch(0.530 0.160 46.5)" },
        "800": { "value": "oklch(0.440 0.130 46.5)" },
        "900": { "value": "oklch(0.370 0.100 46.5)" },
        "950": { "value": "oklch(0.270 0.070 46.5)" }
      }
    }
  }
}'
